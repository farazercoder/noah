{
  "expo": {
    "name": "CardVault",
    "slug": "CardVault",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F1A"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "NSCameraUsageDescription": "CardVault needs camera access to scan and identify your sports cards.",
        "NSPhotoLibraryUsageDescription": "CardVault needs photo library access to import card images for identification."
      },
      "bundleIdentifier": "com.cardvault.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0F1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "package": "com.cardvault.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "CardVault needs camera access to scan your sports cards."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CardVault needs photo access to import card images."
        }
      ]
    ]
  }
}
